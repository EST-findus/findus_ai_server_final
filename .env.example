# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채운다. .env 는 git 에 올라가지 않는다 (키를 여기 적지 말 것).
# 이미 정한 환경 변수($env:, setx)가 .env 보다 우선한다. 나머지 설정은 README "환경 변수" 표 참고.

# 정하면 모든 /v1/* 요청에 X-API-Key 헤더가 필요하다 (시험 페이지는 맨 위 "API 키" 칸).
# 만들기: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# true 면 DB 원본 작업(/test/workbench)을 다른 PC(Cloudflare 터널 등)에서도 쓴다. API_KEY 가 있어야 열린다.
WORKBENCH_REMOTE=false
